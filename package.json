{
	"name": "lang-compare",
	"description": "A comprehensive tool for comparing programming languages side-by-side",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"keywords": [
		"svelte",
		"sveltekit",
		"programming-languages",
		"comparison",
		"typescript",
		"tailwindcss",
		"daisyui"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/your-username/lang-compare.git"
	},
	"author": "Developer",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "node ./scripts/prepare-data.mjs && vite build",
		"preview": "vite preview",
		"verify:snippets": "node ./scripts/prepare-data.mjs && node ./scripts/verify-snippets.mjs && node ./scripts/prepare-data.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"bmad:refresh": "bmad-method install -f -i codex",
		"bmad:list": "bmad-method list:agents",
		"bmad:validate": "bmad-method validate"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@vitest/browser": "^3.2.3",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"remark-parse": "^11.0.0",
		"shiki": "^1.1.7",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"unified": "^11.0.4",
		"vite": "^7.0.4",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"dependencies": {
		"daisyui": "^5.0.54",
		"remark-gfm": "^4.0.1",
		"sucrase": "^3.35.1",
		"svelte-persisted-store": "^0.12.0"
	}
}
